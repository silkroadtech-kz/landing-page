{
  "cleanUrls": true,
  "redirects": [
	{
	  "source": "/ru",
	  "destination": "/",
	  "permanent": true
	},
	{
	  "source": "/ru/:path*",
	  "destination": "/:path*",
	  "permanent": true
	},
    {
      "source": "/landing",
      "destination": "/#services",
      "permanent": true
    },
    {
      "source": "/:path*",
      "has": [{ "type": "host", "value": "www.silkroadtech.kz" }],
      "destination": "https://silkroadtech.kz/:path*",
      "permanent": true
    }
	],
	"headers": [
	  {
		"source": "/(robots.txt|sitemap.xml)",
		"headers": [{ "key": "Cache-Control", "value": "public, max-age=0, s-maxage=3600" }]
	  }
	]
}
