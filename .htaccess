# ============================================================
#  silkroadtech.kz — конфигурация Apache/LiteSpeed
#  Заменяет vercel.json при хостинге на ps.kz (shared).
# ============================================================

# Options здесь намеренно не задаётся: на shared-хостинге AllowOverride
# обычно её не разрешает, и Apache отвечает 500 «Options not allowed here».
# Листинг папок отключён на уровне сервера.
DirectoryIndex index.html

# Apache не должен сам дописывать слеш к адресам-каталогам: иначе /blog
# (где рядом лежат blog.html и каталог blog/ со статьями) уходил в 301
# на /blog/ раньше правил cleanUrls, а те возвращали на /blog — петля.
<IfModule mod_dir.c>
	DirectorySlash Off
</IfModule>

# ------------------------------------------------------------
#  1. РЕДИРЕКТЫ  (порядок важен — сверху вниз)
# ------------------------------------------------------------
<IfModule mod_rewrite.c>
	RewriteEngine On

	# --- HTTPS (на Vercel было автоматом) ---
	RewriteCond %{HTTPS} !=on
	RewriteCond %{HTTP:X-Forwarded-Proto} !https
	RewriteRule ^(.*)$ https://%{HTTP_HOST}/$1 [R=301,L]

	# --- www.silkroadtech.kz → silkroadtech.kz ---
	RewriteCond %{HTTP_HOST} ^www\.silkroadtech\.kz$ [NC]
	RewriteRule ^(.*)$ https://silkroadtech.kz/$1 [R=301,L]

	# --- /ru и /ru/* → корень (было в vercel.json) ---
	RewriteRule ^ru/?$ / [R=301,L]
	RewriteRule ^ru/(.*)$ /$1 [R=301,L]

	# --- /landing → /#services ---
	RewriteRule ^landing/?$ /#services [R=301,L,NE]

	# --- cleanUrls: /about.html → /about (канонический адрес) ---
	# Файлы подтверждения прав Google Search Console и Яндекс.Вебмастера
	# должны отдаваться по точному адресу с .html, без редиректа.
	RewriteCond %{REQUEST_URI} !^/(google[0-9a-f]+|yandex_[0-9a-f]+)\.html$
	RewriteCond %{THE_REQUEST} \s/+(.+?)\.html[\s?] [NC]
	RewriteRule ^ /%1 [R=301,L,NE]

	# --- cleanUrls: /blog/ → /blog (канонический адрес без слеша) ---
	# Нужно для адресов, у которых есть и файл blog.html, и одноимённый
	# каталог blog/ со статьями. Проверка через DOCUMENT_ROOT, а не
	# REQUEST_FILENAME: для каталога тот приходит со слешем на конце,
	# и условие «blog/.html существует» никогда не выполнялось.
	RewriteCond %{DOCUMENT_ROOT}/$1.html -f
	RewriteRule ^(.+)/$ /$1 [R=301,L]

	# --- cleanUrls: отдаём /about из about.html ---
	# Файл имеет приоритет над одноимённым каталогом, как в cleanUrls Vercel:
	# /blog отдаёт blog.html, а не уходит в mod_dir (301 на /blog/ → 403).
	RewriteCond %{DOCUMENT_ROOT}/$1.html -f
	RewriteRule ^(.+)$ $1.html [L]
</IfModule>

# ------------------------------------------------------------
#  2. СЖАТИЕ
# ------------------------------------------------------------
<IfModule mod_brotli.c>
	AddOutputFilterByType BROTLI_COMPRESS text/html text/plain text/css text/xml \
		application/javascript application/json application/xml image/svg+xml
</IfModule>

<IfModule mod_deflate.c>
	AddOutputFilterByType DEFLATE text/html text/plain text/css text/xml \
		application/javascript application/json application/xml image/svg+xml
</IfModule>

# ------------------------------------------------------------
#  3. КЭШИРОВАНИЕ
# ------------------------------------------------------------
<IfModule mod_expires.c>
	ExpiresActive On

	# Картинки, видео, шрифты — год (имена стабильные)
	ExpiresByType image/webp              "access plus 1 year"
	ExpiresByType image/png               "access plus 1 year"
	ExpiresByType image/jpeg              "access plus 1 year"
	ExpiresByType image/svg+xml           "access plus 1 year"
	ExpiresByType image/x-icon            "access plus 1 year"
	ExpiresByType video/mp4               "access plus 1 year"
	ExpiresByType audio/mpeg              "access plus 1 year"
	ExpiresByType font/woff2              "access plus 1 year"

	# CSS/JS — неделя (нет хэшей в именах, иначе правки не доедут)
	ExpiresByType text/css                "access plus 1 week"
	ExpiresByType application/javascript  "access plus 1 week"

	# HTML — не кэшируем
	ExpiresByType text/html               "access plus 0 seconds"
</IfModule>

<IfModule mod_headers.c>
	# robots.txt и sitemap.xml — как было в vercel.json
	<FilesMatch "^(robots\.txt|sitemap\.xml)$">
		Header set Cache-Control "public, max-age=0, s-maxage=3600"
	</FilesMatch>

	<FilesMatch "\.html$">
		Header set Cache-Control "public, max-age=0, must-revalidate"
	</FilesMatch>

	# --- Безопасность ---
	Header always set X-Content-Type-Options "nosniff"
	Header always set X-Frame-Options "SAMEORIGIN"
	Header always set Referrer-Policy "strict-origin-when-cross-origin"
	Header always set Permissions-Policy "geolocation=(), microphone=(), camera=()"

	# Убираем лишнее
	Header unset X-Powered-By
</IfModule>

# ------------------------------------------------------------
#  4. MIME-ТИПЫ  (на некоторых shared-конфигах webp/woff2 не заданы)
# ------------------------------------------------------------
<IfModule mod_mime.c>
	AddType image/webp                   .webp
	AddType image/svg+xml                .svg
	AddType font/woff2                   .woff2
	AddType application/manifest+json     .webmanifest
	AddType video/mp4                    .mp4
	AddType audio/mpeg                   .mp3
</IfModule>

# ------------------------------------------------------------
#  5. ЗАЩИТА СЛУЖЕБНЫХ ФАЙЛОВ
# ------------------------------------------------------------
# Эти файлы в сборку не попадают (см. scripts/build-deploy.sh), правило —
# страховка на случай ручной заливки. Обёрнуто в IfModule: без mod_authz_core
# директива Require роняет весь .htaccess с ошибкой 500.
<IfModule mod_authz_core.c>
	<FilesMatch "^(package(-lock)?\.json|compress\.mjs|vercel\.json|tailwind\.input\.css|\.env.*|.*\.mjs)$">
		Require all denied
	</FilesMatch>
</IfModule>

# ------------------------------------------------------------
#  6. СТРАНИЦЫ ОШИБОК
# ------------------------------------------------------------
# Раскомментировать, когда появится 404.html.
# Отдавать здесь index.html нельзя — получится «мягкий 404», Google
# посчитает несуществующие адреса рабочими страницами-дублями.
# ErrorDocument 404 /404.html
